 #define NBDC_DO_LIST 1
 
+/* TCP pode devolver menos bytes que o campo solicitado. */
+static void read_all(int sock, void *buffer, size_t length, const char *where)
+{
+	char *cursor = buffer;
+	while (length != 0) {
+		ssize_t got = read(sock, cursor, length);
+		if (got == 0) {
+			errno = ECONNRESET;
+			err("NBD: servidor fechou a conexao: %m");
+		}
+		if (got < 0) {
+			if (errno == EINTR)
+				continue;
+			err("NBD: leitura falhou: %m");
+		}
+		cursor += got;
+		length -= (size_t)got;
+	}
+}
