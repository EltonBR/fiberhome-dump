{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compilar ARM/uClibc",
            "type": "shell",
            "command": "make",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "verificar no host",
            "type": "shell",
            "command": "make host-check",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
