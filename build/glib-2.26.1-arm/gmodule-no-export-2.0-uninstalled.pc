prefix=/usr
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

gmodule_supported=true

Name: GModule
Description: Dynamic module loader for GLib
Requires: glib-2.0
Version: 2.26.1
Libs: ${pc_top_builddir}/${pcfiledir}/gmodule/libgmodule-2.0.la -pthread 
Cflags: -I${pc_top_builddir}/${pcfiledir}/../../third_party/glib-2.26.1/gmodule -pthread

