	LC_ALL=C docbook2man nbd-server.1.in.sgml
	cat sh.tmpl > nbd-server.1.sh.in
	cat NBD-SERVER.1 >> nbd-server.1.sh.in
	echo "EOF" >> nbd-server.1.sh.in
	rm NBD-SERVER.1
